{
  "id": "/",
  "name": "내 가계부",
  "short_name": "가계부",
  "description": "입력이 귀찮지 않은 내 가계부 — 카드 앱 캡처 한 장이면 끝",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFFBF7",
  "theme_color": "#FFFBF7",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "기록 추가", "short_name": "기록 추가", "url": "/entry", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "캡처로 입력", "short_name": "캡처로 입력", "url": "/capture", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  }
}
