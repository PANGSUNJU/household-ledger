# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채워 주세요.
# Supabase 대시보드 → Project Settings → API 에서 확인할 수 있어요.
# anon key는 브라우저에 공개되는 값이라 괜찮아요. (service_role 키는 절대 넣지 마세요)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에-anon-public-키

# 폰 푸시 알림용 공개 열쇠 (docs/DEPLOY.md 8번). 비워 두면 알림 받기 버튼 대신 안내가 보여요.
# 짝이 되는 비밀 열쇠(VAPID_PRIVATE_KEY)는 여기 넣지 말고 Supabase Edge Function Secrets 에만 넣어요.
VITE_VAPID_PUBLIC_KEY=
