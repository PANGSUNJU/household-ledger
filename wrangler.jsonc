// Cloudflare 배포 설정 (Workers & Pages → 'npx wrangler deploy' 가 이 파일을 읽는다)
//  · 서버 코드 없이 빌드된 화면 파일(dist)만 올린다
//  · 없는 주소(/stats, /settings 등)로 바로 들어와도 앱(index.html)을 보여준다 (새로고침 404 방지)
{
  "name": "household-ledger",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
